{
  "name": "gusto-manager-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.1",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node app.js",
    "lint": "../client/node_modules/.bin/eslint . --ext .js",
    "lint:fix": "../client/node_modules/.bin/eslint . --ext .js --fix",
    "lint:files": "../client/node_modules/.bin/eslint",
    "lint:files:fix": "../client/node_modules/.bin/eslint --fix",
    "test:gift-card-typography": "node --test tests/gift-card-typography.test.js",
    "test:personnel-overnight": "TZ=Europe/Paris node --test tests/personnel-overnight.test.js",
    "test:quick-slot-closures": "TZ=Europe/Paris node --test tests/reservation-quick-slot-closure.test.js",
    "test:take-away-security": "TZ=Europe/Paris node --test tests/take-away-security.test.js",
    "test:take-away-reliability": "TZ=Europe/Paris node --test tests/take-away-reliability.test.js",
    "test:take-away": "TZ=Europe/Paris node --test tests/take-away-security.test.js tests/take-away-reliability.test.js tests/take-away-webapp.test.js tests/take-away-stripe-events.test.js tests/take-away-adjustments.test.js tests/take-away-mailer.test.js tests/take-away-visibility.test.js tests/take-away-pagination.test.js",
    "test:sms-reminders": "TZ=UTC node --test tests/sms-reminders.test.js",
    "import:customers:xlsx": "node utils/script/importCustomersFromXlsx.script.js",
    "customers:recompute-tags": "node utils/script/recomputeCustomerTags.script.js",
    "sms:seed-fr-policy": "node utils/script/seedSmsFrancePolicy.script.js",
    "sms:seed-international-policies": "node scripts/seedSmsInternationalPolicies.script.js",
    "sms:backfill-self-service": "node scripts/backfillSmsSelfServiceEligibility.script.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.9",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-session": "^1.18.2",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.13",
    "luxon": "^3.7.2",
    "mongodb": "^6.16.0",
    "mongoose": "^8.24.7",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.0.6",
    "pdfkit": "^0.17.2",
    "sharp": "0.35.5",
    "sib-api-v3-sdk": "^8.5.0",
    "streamifier": "^0.1.1",
    "stripe": "^18.5.0",
    "tar": "^7.5.22",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5"
  }
}
